{
  "name": "template-profissional-saude",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "packageManager": "npm@10.9.7",
  "engines": {
    "node": ">=22.12.0 <23",
    "npm": ">=10.9.0 <11"
  },
  "scripts": {
    "dev": "astro dev",
    "validate": "tsx scripts/validate-config.ts",
    "validate:prod": "tsx scripts/validate-config.ts --production",
    "impressos": "tsx scripts/gerar-impressos.ts",
    "pendencias": "tsx scripts/validate-config.ts --relatorio",
    "check": "npm run validate && astro check",
    "build": "tsx scripts/validate-config.ts --build && astro build && tsx scripts/gerar-csp.ts && tsx scripts/audit-compliance.ts",
    "preview": "astro preview",
    "audit:compliance": "tsx scripts/audit-compliance.ts",
    "audit:a11y": "tsx scripts/audit-a11y.ts",
    "audit:lighthouse": "tsx scripts/audit-lighthouse.ts"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "@fontsource-variable/hanken-grotesk": "5.3.0",
    "@fontsource/cormorant-garamond": "5.3.0",
    "@fontsource/great-vibes": "5.3.0",
    "astro": "5.18.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@types/node": "22.20.4",
    "@types/qrcode": "1.5.6",
    "axe-core": "4.13.0",
    "lighthouse": "13.5.0",
    "playwright-core": "1.56.1",
    "qrcode": "1.5.4",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
