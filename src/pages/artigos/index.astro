---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/Section.astro';
import Card from '../../components/Card.astro';
import Tag from '../../components/Tag.astro';
import { copy } from '../../config/copy.pt-BR';

const artigos = (await getCollection('artigos', (a) => import.meta.env.DEV || !a.data.rascunho)).sort(
  (a, b) => b.data.revisadoEm.valueOf() - a.data.revisadoEm.valueOf(),
);
---
<BaseLayout titulo={copy.artigos.titulo} descricao={copy.artigos.descricao}>
  <Section id="artigos" titulo={copy.artigos.titulo}>
    <p>{copy.artigos.descricao}</p>
    <ul class="grade lista" role="list">
      {artigos.map((a) => (
        <Card as="li" class="col-4" href={`/artigos/${a.id}/`}>
          <Tag slot="topo">{a.data.categoria}</Tag>
          <h3>{a.data.titulo}</h3>
          <p>{a.data.resumo}</p>
          <Fragment slot="rotulo-link">{copy.artigos.lerMais}: {a.data.titulo}</Fragment>
        </Card>
      ))}
    </ul>
  </Section>
</BaseLayout>
<style>.lista { list-style: none; padding: 0; margin-top: var(--esp-6); }</style>
