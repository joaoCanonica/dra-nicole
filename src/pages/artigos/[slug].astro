---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/Section.astro';
import Link from '../../components/Link.astro';
import { copy } from '../../config/copy.pt-BR';

export async function getStaticPaths() {
  const artigos = await getCollection('artigos', (a) => import.meta.env.DEV || !a.data.rascunho);
  return artigos.map((artigo) => ({ params: { slug: artigo.id }, props: { artigo } }));
}
const { artigo } = Astro.props;
const { Content } = await render(artigo);
const data = (d: Date) => d.toLocaleDateString('pt-BR', { timeZone: 'UTC' });
---
<BaseLayout titulo={artigo.data.titulo} descricao={artigo.data.resumo}>
  <Section largura="texto">
    <article class="artigo">
      <h1>{artigo.data.titulo}</h1>
      <p><small>{copy.artigos.revisadoEm} {data(artigo.data.revisadoEm)}</small></p>
      <Content />
      <aside><p><strong>{artigo.data.aviso}</strong></p></aside>
      <h2>{copy.artigos.fontes}</h2>
      <ol>{artigo.data.fontes.map((f) => <li><Link href={f.url}>{f.nome}</Link> ({copy.artigos.acessoEm} {data(f.dataAcesso)})</li>)}</ol>
    </article>
  </Section>
</BaseLayout>
<style>.artigo { display: grid; gap: var(--esp-5); }</style>
