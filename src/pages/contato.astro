---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import Texto from '../components/Texto.astro';
import Icon from '../components/Icon.astro';
import Button from '../components/Button.astro';
import BotaoWhatsapp from '../components/BotaoWhatsapp.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Container from '../components/Container.astro';
import { schemaConsultorio } from '../lib/schema';
import FormContato from '../components/FormContato.astro';
import ComoAgendar from '../components/secoes/ComoAgendar.astro';
import { copy } from '../config/copy.pt-BR';
import { contato } from '../config/contato.config';
import { CONFIRMAR, profile, telefoneUrl } from '../config/profile.config';

const c = copy.contato;
const site = Astro.site ?? new URL(Astro.url.origin);
const jsonLd = JSON.stringify(schemaConsultorio(site));
const r = c.rotulos;
const e = profile.endereco;
const linhaEndereco = [e.logradouro, e.complemento, e.bairro, `${e.cidade}-${e.uf}`, e.cep].filter(Boolean).join(', ');
const horarios = profile.horarios === CONFIRMAR ? null : profile.horarios;
const mapas = import.meta.glob<{ default: ImageMetadata }>('../assets/mapa/*.{png,jpg,jpeg,webp,avif}', { eager: true });
const imagemMapa = contato.mapa.imagem ? mapas[`../assets/mapa/${contato.mapa.imagem}`]?.default : undefined;
const urlMapa = contato.mapa.urlGoogleMaps === CONFIRMAR ? e.urlMapa : contato.mapa.urlGoogleMaps;
---
<BaseLayout tituloCompleto={copy.seo.contato.titulo} descricao={copy.seo.contato.descricao}>
  <script type="application/ld+json" set:html={jsonLd} slot="head" />
  <Container><Breadcrumbs itens={[{ nome: c.eyebrow, caminho: '/contato/' }]} /></Container>
  <Section id="contato" eyebrow={c.eyebrow} titulo={c.titulo} nivelTitulo={1}>
    <div class="contato grade">
      <div class="contato__info">
        <dl class="contato__lista">
          <div>
            <dt><Icon nome="local" /> {r.endereco}</dt>
            <Texto as="dd" valor={linhaEndereco} />
          </div>
          <div>
            <dt><Icon nome="relogio" /> {r.horarios}</dt>
            {horarios ? horarios.map((h) => <dd>{h.dias.map((d) => copy.diasSemana[d]).join(', ')}: {h.abre}–{h.fecha}</dd>) : <Texto as="dd" valor={CONFIRMAR} />}
          </div>
          <div>
            <dt><Icon nome="telefone" /> {r.telefone}</dt>
            <dd><a href={telefoneUrl} data-evento="telefone" data-origem="contato"><Texto valor={profile.telefone.exibicao} /></a></dd>
          </div>
          <div>
            <dt><Icon nome="whatsapp" /> {r.whatsapp}</dt>
            <dd><BotaoWhatsapp variante="secundario" origem="contato">{copy.agendar.cta}</BotaoWhatsapp></dd>
          </div>
        </dl>

        <dl class="contato__lista contato__lista--local">
          <div><dt>{r.comoChegar}</dt><Texto as="dd" valor={contato.comoChegar} /></div>
          <div><dt>{r.estacionamento}</dt><Texto as="dd" valor={contato.estacionamento} /></div>
          <div><dt>{r.acessibilidade}</dt><Texto as="dd" valor={contato.acessibilidade} /></div>
        </dl>
      </div>

      <figure class="contato__mapa">
        {imagemMapa ? (
          <Image src={imagemMapa} alt={c.mapaAlt} widths={[480, 960]} sizes="(min-width: 48rem) 40vw, 100vw" loading="lazy" />
        ) : (
          <div class="contato__mapa-ilustrado" aria-hidden="true">
            <svg viewBox="0 0 320 220" preserveAspectRatio="xMidYMid slice" focusable="false">
              <g fill="none" stroke="currentColor" stroke-width="1" opacity="0.35">
                <path d="M0 60h320M0 140h320M70 0v220M190 0v220M260 0v220" />
                <path d="M0 200c80-30 140-10 200-60s90-60 120-60" stroke-width="6" opacity="0.5" />
              </g>
              <circle cx="190" cy="110" r="22" fill="none" stroke="currentColor" stroke-width="1.5" />
            </svg>
            <span class="contato__pino"><Icon nome="local" tamanho={32} /></span>
          </div>
        )}
        <figcaption>
          <Texto valor={linhaEndereco} />
          <Button href={urlMapa} icone="local" variante="secundario" data-evento="mapa" data-origem="contato">{c.abrirMapa}</Button>
          <small>{c.mapaNota}</small>
        </figcaption>
      </figure>
    </div>
  </Section>

  <Section id="como-agendar" eyebrow={copy.agendar.eyebrow} titulo={copy.agendar.titulo} tom="alt">
    <ComoAgendar />
  </Section>

  <Section id="retorno">
    <FormContato />
  </Section>
</BaseLayout>
<style>
  .contato { row-gap: var(--esp-7); }
  .contato__info { display: grid; gap: var(--esp-6); align-content: start; }
  .contato__lista { display: grid; gap: var(--esp-5); }
  .contato__lista dt { display: flex; align-items: center; gap: var(--esp-2); font-weight: 700; color: var(--cor-acento-texto); }
  .contato__lista dd { margin: var(--esp-1) 0 0; }
  .contato__lista--local { padding-block-start: var(--esp-5); border-block-start: 1px solid var(--cor-borda); }
  .contato__mapa { margin: 0; display: grid; gap: var(--esp-4); align-content: start; }
  .contato__mapa :global(img), .contato__mapa-ilustrado { border-radius: var(--raio-l); border: 1px solid var(--cor-borda); aspect-ratio: 16 / 11; inline-size: 100%; object-fit: cover; }
  .contato__mapa-ilustrado { position: relative; display: grid; place-items: center; background: var(--cor-superficie-alt); color: var(--cor-primaria); overflow: hidden; }
  .contato__mapa-ilustrado svg { position: absolute; inset: 0; inline-size: 100%; block-size: 100%; }
  .contato__pino { position: relative; color: var(--cor-acento-texto); transform: translate(20%, -10%); }
  .contato__mapa figcaption { display: grid; gap: var(--esp-3); justify-items: start; }
  .contato__mapa small { color: var(--cor-texto-suave); }
  @media (min-width: 48rem) {
    .contato__info { grid-column: 1 / span 6; }
    .contato__mapa { grid-column: 8 / -1; }
  }
</style>
