---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import Container from '../components/Container.astro';
import Eyebrow from '../components/Eyebrow.astro';
import Button from '../components/Button.astro';
import Card from '../components/Card.astro';
import { copy } from '../config/copy.pt-BR';
import { compliance } from '../config/compliance.config';
import { whatsappUrl } from '../config/profile.config';

const faq = (await getCollection('faq')).sort((a, b) => a.data.ordem - b.data.ordem);
---
<BaseLayout>
  <Container class="hero grade">
    <div class="col-8 hero__texto">
      <Eyebrow>{copy.hero.eyebrow}</Eyebrow>
      <h1>{copy.hero.titulo}</h1>
      <p class="hero__lead">{copy.hero.texto}</p>
      <div class="hero__acoes">
        <Button href={whatsappUrl} icone="whatsapp">{copy.hero.ctaPrimario}</Button>
        <Button href="#consulta" variante="secundario">{copy.hero.ctaSecundario}</Button>
      </div>
      <p class="hero__aviso">{compliance.avisoWhatsapp}</p>
    </div>
    <p class="col-4 hero__detalhe manuscrita" aria-hidden="true">{copy.hero.detalheManuscrito}</p>
  </Container>

  <Section id="consulta" eyebrow={copy.consulta.eyebrow} titulo={copy.consulta.titulo} tom="superficie">
    <div class="grade">
      <Card class="col-6"><h3>{copy.consulta.titulo}</h3><p>{copy.consulta.duracao}</p></Card>
      <Card class="col-6">
        <h3>O que levar</h3>
        <ul>{copy.consulta.oQueLevar.map((i) => <li>{i}</li>)}</ul>
      </Card>
    </div>
  </Section>

  <Section id="faq" titulo={copy.faq.titulo} largura="texto">
    {faq.map((f) => (
      <details class="faq"><summary>{f.data.pergunta}</summary><p>{f.body}</p></details>
    ))}
  </Section>
</BaseLayout>
<style>
  .hero { padding-block: var(--esp-8) var(--esp-9); align-items: end; }
  .hero__texto { display: grid; gap: var(--esp-5); }
  .hero__lead { font-size: var(--fs-1); color: var(--cor-texto-suave); }
  .hero__acoes { display: flex; flex-wrap: wrap; gap: var(--esp-4); }
  .hero__aviso { font-size: var(--fs-n1); color: var(--cor-texto-suave); }
  .hero__detalhe { font-size: var(--fs-5); text-align: end; opacity: 0.8; }
  .faq { border-bottom: 1px solid var(--cor-borda); padding-block: var(--esp-4); }
  .faq summary { cursor: pointer; font-weight: 600; min-height: 2.75rem; display: flex; align-items: center; }
</style>
