---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import Button from '../components/Button.astro';
import Texto from '../components/Texto.astro';
import Trecho from '../components/linha/Trecho.astro';
import Sobre from '../components/secoes/Sobre.astro';
import AntesDaConsulta from '../components/secoes/AntesDaConsulta.astro';
import Convenios from '../components/secoes/Convenios.astro';
import GuiaConsulta from '../components/GuiaConsulta.astro';
import ComoAgendar from '../components/secoes/ComoAgendar.astro';
import BotaoWhatsapp from '../components/BotaoWhatsapp.astro';
import { copy } from '../config/copy.pt-BR';
import { telefoneUrl } from '../config/profile.config';
import { compliance } from '../config/compliance.config';
import type { FormaTrecho, Lado } from '../lib/linha';
import { schemaConsultorio } from '../lib/schema';

const site = Astro.site ?? new URL(Astro.url.origin);
const jsonLd = JSON.stringify(schemaConsultorio(site));
const faq = (await getCollection('faq')).sort((a, b) => a.data.ordem - b.data.ordem);
// Gestação recebe a curva de ventre; os demais alternam o lado da onda.
const formaDoMarco = (id: string): FormaTrecho => (id === 'gestacao' ? 'ventre' : 'onda');
const lado = (i: number): Lado => (i % 2 === 0 ? 1 : -1);
---
<BaseLayout tituloCompleto={copy.seo.home.titulo} descricao={copy.seo.home.descricao}>
  <script type="application/ld+json" set:html={jsonLd} slot="head" />
  <Hero />

  <Section id="sobre" eyebrow={copy.sobre.eyebrow} titulo={copy.sobre.titulo} trilha>
    <Trecho slot="trilha" forma="onda" lado={1} />
    <Sobre />
  </Section>

  <Section id="areas" eyebrow={copy.areas.eyebrow} titulo={copy.areas.titulo} trilha class="areas-intro">
    <Trecho slot="trilha" forma="onda" lado={-1} />
    <p class="marco__texto">{copy.areas.texto}</p>
  </Section>

  {copy.marcos.itens.map((m, i) => (
    <Section id={m.id} eyebrow={m.eyebrow} titulo={m.titulo} trilha class={`marco marco--${i % 2 ? 'dir' : 'esq'}`}>
      <Trecho slot="trilha" forma={formaDoMarco(m.id)} lado={lado(i)} marco />
      <p class="marco__texto">{m.texto}</p>
      <p class="marco__rotulo">{copy.areas.rotuloLista}</p>
      <ul class="marco__lista">{m.acompanha.map((a) => <li>{a}</li>)}</ul>
    </Section>
  ))}

  <Section id="consulta" eyebrow={copy.consulta.eyebrow} titulo={copy.consulta.titulo} tom="alt" trilha>
    <Trecho slot="trilha" forma="onda" lado={1} marco />
    <AntesDaConsulta />
  </Section>

  <Section id="guia" eyebrow={copy.guia.eyebrow} titulo={copy.guia.titulo} trilha>
    <Trecho slot="trilha" forma="onda" lado={-1} />
    <GuiaConsulta />
  </Section>

  <Section id="convenios" eyebrow={copy.convenios.eyebrow} titulo={copy.convenios.titulo} tom="superficie" trilha>
    <Trecho slot="trilha" forma="onda" lado={1} />
    <Convenios />
  </Section>

  <Section id="como-agendar" eyebrow={copy.agendar.eyebrow} titulo={copy.agendar.titulo} tom="alt" trilha>
    <Trecho slot="trilha" forma="onda" lado={-1} marco />
    <ComoAgendar />
  </Section>

  <Section id="faq" eyebrow={copy.faq.eyebrow} titulo={copy.faq.titulo} trilha>
    <Trecho slot="trilha" forma="onda" lado={-1} />
    <div class="faq-lista">
      {faq.map((f) => (
        <details class="faq">
          <summary>{f.data.pergunta}</summary>
          <Texto as="p" valor={f.body ?? ''} />
        </details>
      ))}
    </div>
  </Section>

  <Section id="agendar" eyebrow={copy.ctaFinal.eyebrow} titulo={copy.ctaFinal.titulo} trilha class="cta-final">
    <Trecho slot="trilha" forma="fim" lado={1} />
    <p>{copy.ctaFinal.texto}</p>
    <div class="cta-final__acoes">
      <BotaoWhatsapp origem="cta-final">{copy.ctaFinal.ctaPrimario}</BotaoWhatsapp>
      <Button href={telefoneUrl} icone="telefone" variante="secundario" data-evento="telefone" data-origem="cta-final">{copy.ctaFinal.ctaTelefone}</Button>
    </div>
    <p class="cta-final__aviso">{compliance.avisoWhatsapp}</p>
  </Section>
</BaseLayout>
<style>
  :global(.marco .secao__cabecalho) { margin-bottom: var(--esp-4); }
  .marco__texto { font-size: var(--fs-1); color: var(--cor-texto-suave); max-inline-size: 46ch; }
  .marco__rotulo { margin-block-start: var(--esp-5); font-size: var(--fs-n1); font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--cor-acento-texto); }
  .marco__lista { display: flex; flex-wrap: wrap; gap: var(--esp-2) var(--esp-3); list-style: none; padding: 0; margin-block-start: var(--esp-3); max-inline-size: 40rem; }
  .marco__lista li { padding: var(--esp-2) var(--esp-4); border-radius: var(--raio-pilula); background: var(--cor-agua-suave); color: var(--cor-texto); font-size: var(--fs-n1); }
  @media (min-width: 64rem) {
    /* Composição editorial: marcos alternam entre a margem da linha e o centro. */
    :global(.marco--dir .trilha > :not(.trecho)) { margin-inline-start: 30%; }
  }
  .faq-lista { max-inline-size: var(--medida-texto); }
  .faq { border-bottom: 1px solid var(--cor-borda); padding-block: var(--esp-3); }
  .faq summary { cursor: pointer; font-weight: 600; min-height: 2.75rem; display: flex; align-items: center; }
  .faq :global(p) { padding-block: var(--esp-2) var(--esp-3); color: var(--cor-texto-suave); }
  :global(.cta-final .trilha) { display: grid; gap: var(--esp-5); justify-items: start; }
  .cta-final__acoes { display: flex; flex-wrap: wrap; gap: var(--esp-4); }
  .cta-final__aviso { font-size: var(--fs-n1); color: var(--cor-texto-suave); }
</style>
