---
import '../styles/global.css';
import { gerarTokensCss } from '../styles/tokens';
import { copy } from '../config/copy.pt-BR';
import { compliance } from '../config/compliance.config';
import { profile } from '../config/profile.config';
import { theme } from '../config/theme.config';
import Container from '../components/Container.astro';
import Link from '../components/Link.astro';
import AvisoEmergencia from '../components/AvisoEmergencia.astro';
import BarraContato from '../components/BarraContato.astro';
import Consentimento from '../components/Consentimento.astro';
import RodapeLegal from '../components/RodapeLegal.astro';
import fonteDisplay from '@fontsource/cormorant-garamond/files/cormorant-garamond-latin-500-normal.woff2?url';
import fonteTexto from '@fontsource-variable/hanken-grotesk/files/hanken-grotesk-latin-wght-normal.woff2?url';

interface Props {
  /** Título da página; recebe o sufixo com o nome. Use `tituloCompleto` para substituir tudo. */
  titulo?: string;
  tituloCompleto?: string;
  descricao?: string;
  /** false = noindex (ex.: /avaliar, que é alvo de QR e não deve aparecer na busca). */
  indexar?: boolean;
  /** Página enxuta: sem menu nem barra fixa de contato. */
  minimo?: boolean;
  tipoOg?: 'website' | 'article';
}
const { titulo, tituloCompleto, descricao = copy.meta.descricao, indexar = true, minimo = false, tipoOg = 'website' } = Astro.props;
const tituloFinal = tituloCompleto ?? (titulo ? `${titulo}${copy.meta.separador}${copy.meta.tituloPadrao}` : copy.meta.tituloPadrao);
const site = Astro.site ?? new URL(Astro.url.origin);
const canonical = new URL(Astro.url.pathname, site);
const ogImagem = new URL('/og.png', site);
const tokens = gerarTokensCss();
---
<!doctype html>
<html lang={profile.idioma}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preload" href={fonteDisplay} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={fonteTexto} as="font" type="font/woff2" crossorigin />
    <title>{tituloFinal}</title>
    <meta name="description" content={descricao} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content={theme.cores.claro.fundo} media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content={theme.cores.escuro.fundo} media="(prefers-color-scheme: dark)" />
    <meta property="og:title" content={tituloFinal} />
    <meta property="og:description" content={descricao} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={profile.idioma.replace('-', '_')} />
    <meta property="og:type" content={tipoOg} />
    <meta property="og:site_name" content={copy.meta.tituloPadrao} />
    <meta property="og:image" content={ogImagem} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={copy.seo.ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    {!indexar && <meta name="robots" content="noindex, follow" />}
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <style is:inline set:html={tokens}></style>
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#conteudo">{copy.a11y.pularParaConteudo}</a>
    <Container as="header" class="topo">
      <a href="/" class="topo__marca">{copy.meta.tituloPadrao.split(copy.meta.separador)[0]}</a>
      {!minimo && <nav aria-label={copy.a11y.menu}>
        <ul class="topo__nav">{copy.nav.map((i) => <li><Link href={i.href} sutil>{i.rotulo}</Link></li>)}</ul>
      </nav>}
    </Container>
    <main id="conteudo"><slot /></main>
    <footer class="rodape">
      <Container>
        <AvisoEmergencia />
        <RodapeLegal />
        <p class="rodape__legal">{compliance.avisoConteudo}</p>
        <Consentimento />
      </Container>
    </footer>
    {!minimo && <BarraContato />}
  </body>
</html>
<style>
  :global(.topo) { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--esp-4); padding-block: var(--esp-5); }
  .topo__marca { font-family: var(--fonte-display); font-size: var(--fs-2); color: var(--cor-texto); text-decoration: none; }
  .topo__nav { display: flex; flex-wrap: wrap; gap: var(--esp-2) var(--esp-4); list-style: none; padding: 0; }
  .topo__nav :global(a) { display: inline-flex; align-items: center; min-block-size: 2.75rem; }
  .rodape { background: var(--cor-superficie-alt); padding-block: var(--esp-8); font-size: var(--fs-n1); color: var(--cor-texto-suave); }
  .rodape :global(.container) { display: grid; gap: var(--esp-4); }
</style>
