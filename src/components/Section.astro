---
import Container from './Container.astro';
import Eyebrow from './Eyebrow.astro';

interface Props {
  id?: string;
  titulo?: string;
  eyebrow?: string;
  tom?: 'fundo' | 'superficie' | 'alt';
  largura?: 'texto' | 'padrao' | 'larga';
  /** Reserva a trilha lateral da Linha da Vida (slot "trilha"). */
  trilha?: boolean;
  /** 1 quando a seção abre a página (título vira o h1). */
  nivelTitulo?: 1 | 2;
  class?: string;
}
const { id, titulo, eyebrow, tom = 'fundo', largura = 'padrao', trilha = false, nivelTitulo = 2, class: cls } = Astro.props;
const Titulo = nivelTitulo === 1 ? 'h1' : 'h2';
const tituloId = titulo && id ? `${id}-titulo` : undefined;
---
<section id={id} class:list={['secao', `secao--${tom}`, cls]} aria-labelledby={tituloId}>
  <Container largura={largura} class={trilha ? 'trilha' : undefined}>
    <slot name="trilha" />
    {(titulo || eyebrow) && (
      <header class="secao__cabecalho">
        {eyebrow && <Eyebrow>{eyebrow}</Eyebrow>}
        {titulo && <Titulo id={tituloId}>{titulo}</Titulo>}
      </header>
    )}
    <slot />
  </Container>
</section>
<style>
  .secao { --secao-pad: var(--esp-9); padding-block: var(--secao-pad); scroll-margin-top: var(--esp-5); }
  .secao--superficie { background: var(--cor-superficie); }
  .secao--alt { background: var(--cor-superficie-alt); }
  .secao__cabecalho { display: grid; gap: var(--esp-3); margin-bottom: var(--esp-6); }
</style>
