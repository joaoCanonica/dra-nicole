---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from './Container.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import Texto from './Texto.astro';
import type { SecaoLegal } from '../config/legal.pt-BR';

interface Props { titulo: string; resumo: string; versao: string; vigenteDesde: string; secoes: readonly SecaoLegal[]; caminho: string; rotuloVersao: string; rotuloIndice: string }
const { titulo, resumo, versao, vigenteDesde, secoes, caminho, rotuloVersao, rotuloIndice } = Astro.props;
---
<BaseLayout titulo={titulo} descricao={resumo}>
  <Container largura="texto">
    <article class="legal">
      <Breadcrumbs itens={[{ nome: titulo, caminho }]} />
      <h1>{titulo}</h1>
      <p class="legal__resumo">{resumo}</p>
      <p class="legal__versao"><Texto valor={`${rotuloVersao} ${versao} · ${vigenteDesde}`} /></p>
      <nav aria-labelledby="legal-indice"><h2 id="legal-indice" class="legal__indice-titulo">{rotuloIndice}</h2>
        <ol class="legal__indice">{secoes.map((s) => <li><a href={`#${s.id}`}>{s.titulo}</a></li>)}</ol>
      </nav>
      {secoes.map((s) => (
        <section id={s.id} aria-labelledby={`${s.id}-t`}>
          <h2 id={`${s.id}-t`}>{s.titulo}</h2>
          {s.paragrafos?.map((p) => <Texto as="p" valor={p} />)}
          {s.lista && <ul>{s.lista.map((i) => <Texto as="li" valor={i} />)}</ul>}
          {s.tabela && (
            <div class="legal__tabela" role="region" aria-label={s.titulo} tabindex="0">
              <table>
                <thead><tr>{s.tabela.cabecalho.map((c) => <th scope="col">{c}</th>)}</tr></thead>
                <tbody>{s.tabela.linhas.map((l) => <tr>{l.map((c, i) => (i === 0 ? <th scope="row">{c}</th> : <td>{c}</td>))}</tr>)}</tbody>
              </table>
            </div>
          )}
        </section>
      ))}
    </article>
  </Container>
</BaseLayout>
<style>
  .legal { display: grid; gap: var(--esp-5); padding-block: var(--esp-6) var(--esp-9); }
  .legal h1 { font-size: var(--fs-4); }
  .legal h2 { font-size: var(--fs-2); margin-block-start: var(--esp-4); }
  .legal section { display: grid; gap: var(--esp-3); scroll-margin-top: var(--esp-5); }
  .legal ul, .legal__indice { padding-inline-start: 1.2em; display: grid; gap: var(--esp-2); }
  .legal__indice a { display: inline-block; min-block-size: 1.5rem; }
  .legal__resumo { font-size: var(--fs-1); color: var(--cor-texto-suave); }
  .legal__versao, .legal__indice-titulo { font-size: var(--fs-n1); color: var(--cor-texto-suave); }
  .legal__indice-titulo { font-family: var(--fonte-texto); font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; }
  .legal__tabela { overflow-x: auto; border: 1px solid var(--cor-borda); border-radius: var(--raio-m); }
  .legal__tabela:focus-visible { outline: 3px solid var(--cor-foco); outline-offset: 2px; }
  table { border-collapse: collapse; inline-size: 100%; min-inline-size: 36rem; font-size: var(--fs-n1); }
  th, td { text-align: start; vertical-align: top; padding: var(--esp-3); border-block-end: 1px solid var(--cor-borda); }
  thead th { background: var(--cor-superficie-alt); }
</style>
