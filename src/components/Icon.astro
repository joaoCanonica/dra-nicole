  info: 'M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20Zm1 15h-2v-6h2v6Zm0-8h-2V7h2v2Z',
} as const;

export type NomeIcone = keyof typeof paths;
interface Props { nome: NomeIcone; tamanho?: number; label?: string; class?: string }
const { nome, tamanho = 20, label, class: cls } = Astro.props;
---
<svg
  class:list={['icone', cls]}
  width={tamanho}
  height={tamanho}
  viewBox="0 0 24 24"
  fill="currentColor"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
><path d={paths[nome]} /></svg>
<style>.icone { flex-shrink: 0; }</style>
